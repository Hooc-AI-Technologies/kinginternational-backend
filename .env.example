PORT=5000
BACKEND_URL=https://kinginternational.hoocaitechnologies.com
# Comma-separated allowed CORS origins (leave blank for dev open-CORS mode)
# Example: ALLOWED_ORIGINS=https://kinginternational.hoocaitechnologies.com,http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_s3_bucket_name
